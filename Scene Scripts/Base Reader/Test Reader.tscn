[sub_resource type="GDScript" id="GDScript_tv1na"]
script/source = "extends Button

@export var node : Node

@export var name_ : String = \"Dial_1\"
@export var id_ : int = 0

@onready var reader_manager: ReaderManager = $\"../ReaderManager\"

func _on_pressed() -> void:
	reader_manager.StartRead(ReaderManager.ReaderType.DialogueReader,id_,name_)
"

