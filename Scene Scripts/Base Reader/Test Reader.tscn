[sub_resource type="GDScript" id="GDScript_tv1na"]
script/source = "extends Button

@export var type : ReaderManager.ReaderType
@export var name_ : String = \"Dial_1\"

@onready var reader_manager: ReaderManager = $\"../ReaderManager\"

@export var path : String

func _ready() -> void:
	reader_manager.le_file_system = ResourceLoader.load( path,\"\",ResourceLoader.CACHE_MODE_IGNORE )

func _on_pressed() -> void:
	reader_manager.StartRead(type,name_)
"

