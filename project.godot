; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="library_expedition"
run/main_scene="uid://cv7jwmmq5cb4p"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://iantqf4cd3u"

[display]

window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/LeEditor/plugin.cfg", "res://addons/LeFileSystem/plugin.cfg")

[file_customization]

folder_colors={
"res://Base Obj/": "purple",
"res://Draw/": "green",
"res://Old/": "gray",
"res://Scene Scripts/": "orange",
"res://Test Resource/": "purple",
"res://addons/LeEditor/Custom Class/": "blue",
"res://addons/LeEditor/Custom Class/Bakers/": "yellow",
"res://addons/LeEditor/Custom Class/Readers/": "yellow",
"res://addons/LeFileSystem/Custom Class/": "blue"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
